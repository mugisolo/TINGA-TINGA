{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated traveler or staff member profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "role": { "type": "string", "enum": ["traveler", "agent", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "SafariDocument": {
      "title": "SafariDocument",
      "description": "Metadata for safari files synced with Google Drive",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "driveFileId": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 256 },
        "mimeType": { "type": "string", "maxLength": 128 },
        "size": { "type": "number" },
        "webViewLink": { "type": "string", "maxLength": 512 },
        "category": { "type": "string", "enum": ["permit", "itinerary", "voucher", "passport", "invoice", "other"] },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "driveFileId", "name", "userId", "createdAt"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Client safari review with star rating, client name, and Uganda safari destination",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "guestName": { "type": "string", "maxLength": 128 },
        "country": { "type": "string", "maxLength": 100 },
        "destination": { "type": "string", "maxLength": 160 },
        "experienceSlug": { "type": "string", "maxLength": 128 },
        "guideSlug": { "type": "string", "maxLength": 128 },
        "guideName": { "type": "string", "maxLength": 128 },
        "rating": { "type": "number" },
        "title": { "type": "string", "maxLength": 200 },
        "text": { "type": "string", "maxLength": 1500 },
        "date": { "type": "string", "maxLength": 64 },
        "partyType": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["published", "archived"] },
        "authorId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "guestName", "country", "destination", "rating", "title", "text", "date", "status"]
    },
    "SavedItinerary": {
      "title": "SavedItinerary",
      "description": "Custom multi-day Uganda safari plan generated by Gemini and saved to user wallet",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "region": { "type": "string", "maxLength": 200 },
        "budgetTier": { "type": "string", "enum": ["mid-range", "luxury", "signature"] },
        "activityFocus": { "type": "string", "maxLength": 200 },
        "durationDays": { "type": "number" },
        "estimatedPerPersonUSD": { "type": "number" },
        "depositAmountUSD": { "type": "number" },
        "matchedGuideName": { "type": "string", "maxLength": 128 },
        "matchedGuideSlug": { "type": "string", "maxLength": 128 },
        "referenceCode": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "region", "budgetTier", "durationDays", "estimatedPerPersonUSD", "referenceCode", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles keyed by Firebase Auth UID"
    },
    "/safari_documents/{documentId}": {
      "schema": "SafariDocument",
      "description": "Saved safari files and Google Drive links"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Client testimonials and verified guest reviews displayed on the home page carousel"
    },
    "/saved_itineraries/{itineraryId}": {
      "schema": "SavedItinerary",
      "description": "AI-generated custom safari itineraries saved to the user's wallet"
    }
  }
}
