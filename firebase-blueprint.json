{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated traveler, specialist guide, partner lodge, operations staff, or executive admin profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "role": { "type": "string", "enum": ["client", "admin", "partner", "specialist", "staff", "traveler", "agent"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "PortalDispatch": {
      "title": "PortalDispatch",
      "description": "Operational dispatch, field report, allocation update, or staff task created across Client, Admin, Partner, Specialist, and Staff portals",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 128 },
        "portalRole": { "type": "string", "enum": ["client", "admin", "partner", "specialist", "staff"] },
        "category": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "region": { "type": "string", "maxLength": 160 },
        "status": { "type": "string", "enum": ["open", "in_progress", "verified", "resolved"] },
        "priority": { "type": "string", "enum": ["normal", "high", "urgent"] },
        "notes": { "type": "string", "maxLength": 1500 },
        "referenceCode": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "authorName", "portalRole", "category", "title", "region", "status", "priority", "referenceCode", "createdAt"]
    },
    "SafariDocument": {
      "title": "SafariDocument",
      "description": "Metadata for safari files synced with Google Drive",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "driveFileId": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 256 },
        "mimeType": { "type": "string", "maxLength": 128 },
        "size": { "type": "number" },
        "webViewLink": { "type": "string", "maxLength": 512 },
        "category": { "type": "string", "enum": ["permit", "itinerary", "voucher", "passport", "invoice", "other"] },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "driveFileId", "name", "userId", "createdAt"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Client safari review with star rating, client name, and Uganda safari destination",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "guestName": { "type": "string", "maxLength": 128 },
        "country": { "type": "string", "maxLength": 100 },
        "destination": { "type": "string", "maxLength": 160 },
        "experienceSlug": { "type": "string", "maxLength": 128 },
        "guideSlug": { "type": "string", "maxLength": 128 },
        "guideName": { "type": "string", "maxLength": 128 },
        "rating": { "type": "number" },
        "title": { "type": "string", "maxLength": 200 },
        "text": { "type": "string", "maxLength": 1500 },
        "date": { "type": "string", "maxLength": 64 },
        "partyType": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["published", "archived"] },
        "authorId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "guestName", "country", "destination", "rating", "title", "text", "date", "status", "authorId"]
    },
    "SavedItinerary": {
      "title": "SavedItinerary",
      "description": "Custom multi-day Uganda and East Africa safari plan tailored to traveler preferences and saved to user wallet",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "region": { "type": "string", "maxLength": 200 },
        "budgetTier": { "type": "string", "enum": ["mid-range", "luxury", "signature"] },
        "activityFocus": { "type": "string", "maxLength": 200 },
        "durationDays": { "type": "number" },
        "estimatedPerPersonUSD": { "type": "number" },
        "depositAmountUSD": { "type": "number" },
        "matchedGuideName": { "type": "string", "maxLength": 128 },
        "matchedGuideSlug": { "type": "string", "maxLength": 128 },
        "depositPaid": { "type": "boolean" },
        "referenceCode": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "region", "budgetTier", "durationDays", "estimatedPerPersonUSD", "referenceCode", "createdAt"]
    },
    "SavedChecklist": {
      "title": "SavedChecklist",
      "description": "Custom Safari Essentials packing and readiness checklist saved to the user wallet",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "referenceCode": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "totalItems": { "type": "number" },
        "checkedCount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "referenceCode", "title", "totalItems", "checkedCount", "updatedAt"]
    },
    "SafariEvent": {
      "title": "SafariEvent",
      "description": "Confirmed safari event or scheduled trip managed by Admin with toggle for Homepage Carousel vs Upcoming Programs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "shortTabLabel": { "type": "string", "maxLength": 64 },
        "subtitle": { "type": "string", "maxLength": 400 },
        "eventTag": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "enum": ["Cultural & Music Event", "Guaranteed Primate Departure", "Seasonal Migration & Savanna", "Ornithology Special"] },
        "dateWindow": { "type": "string", "maxLength": 128 },
        "durationLabel": { "type": "string", "maxLength": 128 },
        "location": { "type": "string", "maxLength": 256 },
        "spotsRemaining": { "type": "number" },
        "pricePerPersonUSD": { "type": "number" },
        "leadGuideSlug": { "type": "string", "maxLength": 128 },
        "experienceSlug": { "type": "string", "maxLength": 128 },
        "heroImage": { "type": "string", "maxLength": 1024 },
        "statusLabel": { "type": "string", "maxLength": 128 },
        "placement": { "type": "string", "enum": ["carousel", "upcoming", "both"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "category", "dateWindow", "durationLabel", "location", "spotsRemaining", "pricePerPersonUSD", "leadGuideSlug", "heroImage", "placement", "createdAt"]
    },
    "FooterLogo": {
      "title": "FooterLogo",
      "description": "Partner, banking, fintech, or conservation authority logo displayed in the website footer and managed via Admin Dashboard",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "subtitle": { "type": "string", "maxLength": 256 },
        "logoUrl": { "type": "string", "maxLength": 200000 },
        "category": { "type": "string", "enum": ["Government & Conservation", "Banking & Fintech", "Strategic Partner"] },
        "websiteUrl": { "type": "string", "maxLength": 512 },
        "active": { "type": "boolean" },
        "displayOrder": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "subtitle", "logoUrl", "category", "active", "displayOrder", "updatedAt"]
    },
    "SafariLead": {
      "title": "SafariLead",
      "description": "Traveler safari inquiry, custom quote request, and Entebbe coordination lead",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "whatsapp": { "type": "string", "maxLength": 64 },
        "partySize": { "type": "number" },
        "targetDates": { "type": "string", "maxLength": 128 },
        "budgetTier": { "type": "string", "enum": ["mid-range", "luxury", "signature"] },
        "durationDays": { "type": "number" },
        "preferredGuideSlug": { "type": "string", "maxLength": 128 },
        "experienceSlug": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["new", "contacted", "quote_sent", "confirmed"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name", "email", "partySize", "targetDates", "budgetTier", "durationDays", "status", "createdAt"]
    },
    "UserWallet": {
      "title": "UserWallet",
      "description": "Per-user Safari Wallet balances, UWA permit escrow summary, and partner booking summary persisted in Firestore",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "availableBalanceUSD": { "type": "number" },
        "escrowBalanceUSD": { "type": "number" },
        "rewardCreditsUSD": { "type": "number" },
        "permitHoldsCount": { "type": "number" },
        "partnerBookingsCount": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "availableBalanceUSD", "escrowBalanceUSD", "rewardCreditsUSD", "updatedAt"]
    },
    "WalletTransactionRecord": {
      "title": "WalletTransactionRecord",
      "description": "Safari Wallet transaction including deposits, 3-channel withdrawals (Bank Account, Mobile Money MoMo, Enganda Agent Cash), UWA permit escrow holds, and safari deposits",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["deposit", "withdrawal", "permit_escrow", "permit_release", "partner_booking", "safari_deposit", "expedition_reward"] },
        "title": { "type": "string", "maxLength": 256 },
        "subtitle": { "type": "string", "maxLength": 512 },
        "amountUSD": { "type": "number" },
        "direction": { "type": "string", "enum": ["credit", "debit", "escrow_lock", "escrow_unlock"] },
        "status": { "type": "string", "enum": ["completed", "escrow_held", "pending_verification", "refunded"] },
        "paymentRail": { "type": "string", "maxLength": 128 },
        "referenceCode": { "type": "string", "maxLength": 64 },
        "withdrawalChannel": { "type": "string", "enum": ["bank_account", "momo", "enganda_agent"] },
        "cashPickupCode": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "type", "title", "subtitle", "amountUSD", "direction", "status", "paymentRail", "referenceCode", "createdAt"]
    },
    "PartnerHotelRoom": {
      "title": "PartnerHotelRoom",
      "description": "Hotel and motel rooms and per-room nightly tariffs uploaded by partner property owners",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "partnerSlug": { "type": "string", "maxLength": 128 },
        "partnerName": { "type": "string", "maxLength": 200 },
        "partnerCategory": { "type": "string", "enum": ["hotel", "motel", "campsite", "lodge"] },
        "roomName": { "type": "string", "maxLength": 200 },
        "roomType": { "type": "string", "maxLength": 128 },
        "ratePerNightUSD": { "type": "number" },
        "boardBasis": { "type": "string", "enum": ["Bed & Breakfast", "Half Board", "Full Board", "Room Only"] },
        "maxOccupancy": { "type": "number" },
        "bedConfiguration": { "type": "string", "maxLength": 128 },
        "totalRoomsAvailable": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 350000 },
        "amenities": { "type": "array" },
        "uploadedByOwnerName": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "partnerSlug", "partnerName", "partnerCategory", "roomName", "roomType", "ratePerNightUSD", "boardBasis", "maxOccupancy", "bedConfiguration", "totalRoomsAvailable", "imageUrl", "uploadedByOwnerName", "createdAt"]
    },
    "DriverFleetVehicle": {
      "title": "DriverFleetVehicle",
      "description": "Safari 4x4 fleet vehicles and daily hire rates uploaded by verified Enganda drivers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "driverName": { "type": "string", "maxLength": 128 },
        "driverSlug": { "type": "string", "maxLength": 128 },
        "driverLicenseAndBadge": { "type": "string", "maxLength": 200 },
        "driverPhone": { "type": "string", "maxLength": 64 },
        "driverPhotoUrl": { "type": "string", "maxLength": 350000 },
        "vehicleName": { "type": "string", "maxLength": 200 },
        "vehicleCategory": { "type": "string", "enum": ["4x4 Extended Land Cruiser", "4x4 Land Cruiser Prado", "4x4 Pop-Up Safari Van", "Executive Group Coaster", "Luxury Overland Truck"] },
        "registrationPlate": { "type": "string", "maxLength": 64 },
        "passengerCapacity": { "type": "number" },
        "ratePerDayUSD": { "type": "number" },
        "rateIncludes": { "type": "string", "maxLength": 400 },
        "homeBaseRegion": { "type": "string", "maxLength": 200 },
        "regionsCovered": { "type": "array" },
        "vehicleImageUrl": { "type": "string", "maxLength": 350000 },
        "features": { "type": "array" },
        "availableStatus": { "type": "string", "enum": ["Available Now", "On Charter", "Advance Booking"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "driverName", "driverLicenseAndBadge", "driverPhone", "driverPhotoUrl", "vehicleName", "vehicleCategory", "registrationPlate", "passengerCapacity", "ratePerDayUSD", "rateIncludes", "homeBaseRegion", "vehicleImageUrl", "availableStatus", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles keyed by Firebase Auth UID"
    },
    "/portal_dispatches/{dispatchId}": {
      "schema": "PortalDispatch",
      "description": "Operational dispatches, field logs, partner allocations, and staff actions across the 5 portals"
    },
    "/safari_documents/{documentId}": {
      "schema": "SafariDocument",
      "description": "Saved safari files and expedition documents"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Client testimonials and verified guest reviews displayed on the home page carousel"
    },
    "/saved_itineraries/{itineraryId}": {
      "schema": "SavedItinerary",
      "description": "Custom safari itineraries saved to the user's wallet"
    },
    "/saved_checklists/{checklistId}": {
      "schema": "SavedChecklist",
      "description": "Custom Safari Essentials packing checklists saved to the user's wallet"
    },
    "/safari_events/{eventId}": {
      "schema": "SafariEvent",
      "description": "Safari events and scheduled trips with Homepage Carousel vs Upcoming Programs placement"
    },
    "/footer_logos/{logoId}": {
      "schema": "FooterLogo",
      "description": "Partner and institutional logos displayed in the website footer"
    },
    "/safari_leads/{leadId}": {
      "schema": "SafariLead",
      "description": "Safari inquiries, custom quotes, and Entebbe coordination leads"
    },
    "/user_wallets/{userId}": {
      "schema": "UserWallet",
      "description": "Per-user Safari Wallet balance and escrow summary"
    },
    "/wallet_transactions/{txId}": {
      "schema": "WalletTransactionRecord",
      "description": "Safari Wallet transactions including deposits, Bank/MoMo/Agent Cash withdrawals, and UWA permit escrow locks"
    },
    "/partner_hotel_rooms/{roomId}": {
      "schema": "PartnerHotelRoom",
      "description": "Partner hotel and motel rooms and per-room nightly rates uploaded by hotel and motel owners"
    },
    "/driver_fleet_vehicles/{vehicleId}": {
      "schema": "DriverFleetVehicle",
      "description": "4x4 safari fleet vehicles and daily hire rates uploaded by verified Enganda drivers"
    }
  }
}
