# ============================================================================
# Enganda Safaris — Environment Variables (.env.example)
# Copy to .env for local development or configure in Cloud Run Environment/Secrets
# ============================================================================

# Server-Side Gemini SDK Key (used by server.ts via new GoogleGenAI({ apiKey: process.env.API_KEY }))
API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Runtime Host & Port (Cloud Run sets PORT automatically; defaults to 3000)
PORT=3000
APP_URL="https://your-cloud-run-service.run.app"

# Firebase Client Configuration (Vite SPA — read by src/lib/firebase.ts)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="siz-football-academy-4bae6.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="siz-football-academy-4bae6"
VITE_FIREBASE_STORAGE_BUCKET="siz-football-academy-4bae6.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="614658692954"
VITE_FIREBASE_APP_ID="1:614658692954:web:2667de449e7f17ba514563"
VITE_FIREBASE_MEASUREMENT_ID="G-483ZWSNRT8"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# Optional External Payment & Messaging Integrations
WABA_VERIFY_TOKEN="your_whatsapp_verify_token"
WABA_ACCESS_TOKEN="your_meta_system_user_permanent_token"
WABA_PHONE_ID="your_meta_phone_number_id"
DPO_COMPANY_TOKEN="your_dpo_group_company_token"
DPO_SERVICE_TYPE="3854"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret"
